# Stripe: dashboard.stripe.com/apikeys. Start with the sk_test_ key, switch to sk_live_ when ready.
STRIPE_SECRET_KEY=sk_test_...

# Resend (sends the order emails): resend.com/api-keys, "Full access".
RESEND_API_KEY=re_...

# Where customer replies go, and the email Let's Encrypt uses for the certificate.
SUPPORT_EMAIL=you@example.com

# Domain + DNS: fill in ONE of these.
# GoDaddy (can also buy the domain): developer.godaddy.com/personal-access-token
GODADDY_TOKEN=
# Cloudflare (domain you already own there): dash.cloudflare.com/profile/api-tokens, "Edit zone DNS"
CLOUDFLARE_API_TOKEN=

# Port the web service listens on (nginx forwards to it).
PORT=8750
